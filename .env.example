# Copy to .env and fill in real values:  cp .env.example .env
# Only the variables actually used by the code are listed.
# At least one LLM is required; the chain is Groq -> Gemini -> Cloudflare.

# --- Primary LLM (Groq) ---
GROQ_API_KEY=
GROQ_API_KEY_SECOND=
GROQ_API_KEY_THIRD=

# --- Fallback LLM (Gemini) ---
GEMINI_API_KEY=
GEMINI_API_KEY_ONE=
GEMINI_API_KEY_TWO=
GEMINI_API_KEY_THREE=
GEMINI_API_KEY_FOUR=
GEMINI_API_KEY_FIVE=

# --- Last-resort LLM (Cloudflare Workers AI) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Asset fetching (images) ---
PEXELS_API_KEY=

# Source imagery: real photos that came WITH the story (Reddit post media,
# article og:image / in-body <img>) are harvested at crawl time and used FIRST
# for the beats that name the subject — so a private-person story shows the
# actual person instead of a stand-in. Then Commons (real subjects), then Pexels.
#
# Pexels is the stock provider for generic/symbolic beats (curated, royalty-free,
# tagged). ON by default.
ASSET_ENABLE_PEXELS=1

# Commons is the ARCHIVE source for real, findable subjects. These tune how hard
# we push it (and how a 429 throttle is handled) without changing what counts as
# a good image.
# Requests in flight to the Commons API (burst protection).
ASSET_COMMONS_MAX_INFLIGHT=4
# Adaptive minimum spacing (seconds) between Commons API requests.
ASSET_COMMONS_MIN_GAP=0.08
# Ceiling the spacing widens to when Commons throttles us.
ASSET_COMMONS_MAX_GAP=1.5
# Thumbnail width requested from Commons. 1280 is a standard, usually
# pre-rendered size (a non-standard width is generated on demand and is slow).
ASSET_COMMONS_THUMB_WIDTH=1280
# Run-scoped memo cache for successful Commons searches (seconds).
ASSET_COMMONS_CACHE_TTL=900
# Parallel image downloads from the CDN.
ASSET_DOWNLOAD_MAX_INFLIGHT=8
# Hard wall-clock cap (seconds) per image download. requests' timeout is
# per-read, so a trickling host can otherwise stall a whole run.
ASSET_DOWNLOAD_TIMEOUT=12
# Text-slop filter (deterministic OCR, no LLM). An image is dropped when
# readable words cover > ASSET_MAX_TEXT_AREA (captions/memes/watermarks) from
# several words, OR when tesseract's sparse pass finds ASSET_TEXT_PAGE_BOXES
# boxes at the loose confidence floor (a page/collage of text in ANY language,
# which the English word-confidence path alone cannot see).
ASSET_MAX_TEXT_AREA=0.04
ASSET_TEXT_MIN_CONF=50
ASSET_TEXT_LOOSE_CONF=30
ASSET_TEXT_PAGE_BOXES=25
ASSET_TEXT_MIN_BOXES=4
# Near-duplicate guard: a 64-bit average-hash within this Hamming distance of an
# already-kept image is dropped, so the same face/shot never appears twice.
ASSET_DEDUP_HAMMING=5
# Vision subject check. Ollama serves the VLM with ONE slot (`-np 1`), so keep
# this at 1: concurrent calls only queue, stretch the last call past its timeout,
# and a timed-out image request wedges the runner. Per-call wall-clock cap.
ASSET_VISION_WORKERS=1
ASSET_VISION_TIMEOUT=120
# Openverse (Flickr/maxpixel CC index). OFF by default: its loosely-tagged
# uploads are what filled a serious story with unrelated snapshots. Set 1 to
# re-enable as a last resort behind Pexels + Commons.
ASSET_ENABLE_OPENVERSE=0
# Shot planner: one call that decides what each beat should show and whether it
# is a real archived subject (Commons) or a generic/symbolic one (Pexels).
# Falls back to the entity/query-agent path if it exceeds this many seconds.
ASSET_PLAN_TIMEOUT=45
# DDG generic web-image fallback. OFF by default: it returns unscreened stock.
ASSET_ENABLE_GENERIC=0

# --- Local vision/entity model ---
# Ollama keep-alive so the vision model stays resident between videos.
OLLAMA_KEEP_ALIVE=30m

# --- HuggingFace model cache dir (TTS models land here) ---
HF_HOME=

# --- YouTube upload ---
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_REDIRECT_PORT=8080
YOUTUBE_CATEGORY_ID=27