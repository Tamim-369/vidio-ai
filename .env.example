# Copy to .env and fill in. Only GROQ_API_KEY is required.
#
# The text client falls back in tiers -- Groq, then Gemini, then Cloudflare --
# so the later providers are optional insurance, not required setup.

# --- quote generation: primary ---
GROQ_API_KEY=
# Rotated through on a rate limit. Worth adding for batches.
GROQ_API_KEY_SECOND=
GROQ_API_KEY_THIRD=
# openai/gpt-oss-20b by default; any Groq chat model works.
GROQ_QUOTE_MODEL=openai/gpt-oss-20b

# --- text fallback: only used if every Groq key fails ---
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- youtube: only needed for --upload ---
# Desktop OAuth client JSON, downloaded from the Google Cloud console.
YOUTUBE_CLIENT_SECRETS=client_secrets.json
# public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=27
# Port the OAuth callback lands on. Must be free.
YOUTUBE_REDIRECT_PORT=8080

# --- publishing behaviour ---
# Upload unless a --upload/--no-upload flag says otherwise.
AUTO_PUBLISH=0

# --- model weights ---
# Chatterbox (about 3.3GB) is fetched into this cache on first run.
HF_HOME=
